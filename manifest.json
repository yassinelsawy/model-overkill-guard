{
  "manifest_version": 3,
  "name": "Model Overkill Guard for Claude",
  "version": "0.1.0",
  "description": "Warns you before sending a simple prompt to an overpowered (and overpriced) Claude model on claude.ai.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/main-world-nav-patch.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "content/config.js",
        "content/intent-model.js",
        "content/heuristics.js",
        "content/dom-watcher.js",
        "content/toast.js",
        "content/modal-ui.js",
        "content/live-badge.js",
        "content/new-chat-alert.js",
        "content/interceptor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Model Overkill Guard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
